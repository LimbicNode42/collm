generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../generated/core-client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL_CORE")
  extensions = [vector]
}

model Node {
  id          String  @id @default(cuid())
  topic       String  @unique
  description String?

  // Structured memory fields replacing simple 'state'
  coreContext   String @db.Text // The essential topic/conversation essence - never decays
  workingMemory String @db.Text // Recent compressed state
  keyFacts      Json[] // Structured facts with confidence and metadata
  messageCount  Int    @default(0)
  lastSummaryAt Int    @default(0) // Message count when last summarized

  // The evolving knowledge document — the primary output of the node
  nodeState String @default("") @db.Text

  embedding Unsupported("vector(384)")?
  model     String                      @default("claude-sonnet-4-5-20250929")
  version   Int                         @default(1)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  userId String
  // User relation removed as it's in a different DB. We just store the ID.

  nodeId String
  node   Node   @relation(fields: [nodeId], references: [id])

  targetNodeVersion Int

  status String @default("PENDING")

  // Snapshot of nodeState BEFORE this contribution was applied — enables version diffs
  nodeStateBefore String? @db.Text
}
