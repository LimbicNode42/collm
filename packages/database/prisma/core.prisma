generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output   = "../generated/core-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_CORE")
  extensions = [vector]
}

model Node {
  id          String   @id @default(cuid())
  topic       String   @unique
  description String?
  tags        String[] @default([])
  
  // Structured memory fields replacing simple 'state'
  coreContext       String   @db.Text
  workingMemory     String   @db.Text
  keyFacts          Json[]
  messageCount      Int      @default(0)
  lastSummaryAt     Int      @default(0)
  
  // The evolving knowledge document — the primary output of the node
  nodeState         String   @default("") @db.Text

  embedding   Unsupported("vector(384)")?
  model       String   @default("claude-sonnet-4-5-20250929")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  
  userId    String
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id])
  
  targetNodeVersion Int
  status    String   @default("PENDING")

  // Snapshot of nodeState BEFORE this contribution was applied — enables version diffs
  nodeStateBefore   String?  @db.Text

  // Optional source URL the contributor referenced
  sourceUrl         String?  @db.Text

  votes     Vote[]
}

model Milestone {
  id        String   @id @default(cuid())
  name      String
  nodeId    String
  nodeState String
  version   Int
  createdAt DateTime @default(now())
}

model Vote {
  id         String   @id @default(cuid())
  userId     String
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  value      Int      // +1 upvote, -1 downvote
  createdAt  DateTime @default(now())

  @@unique([userId, messageId])
}
