{
  "name": "core-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:eval": "vitest run --include 'tests/evaluation/**/*.eval.ts'",
    "test:integration": "vitest run --include 'tests/integration/**/*.integration.test.ts'",
    "bench": "vitest bench",
    "bench:run": "vitest bench --run",
    "bench:report": "vitest bench --run --reporter=json > tests/benchmark/results.json"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.936.0",
    "@collm/contracts": "*",
    "@collm/database": "*",
    "@fastify/cors": "^9.0.0",
    "@langchain/anthropic": "^1.2.3",
    "@langchain/google-genai": "^2.0.4",
    "@langchain/openai": "^1.1.3",
    "@xenova/transformers": "^2.17.2",
    "fastify": "^4.0.0",
    "langchain": "^1.1.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
