{
  "name": "message-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --include 'tests/integration/**/*.integration.test.ts'",
    "bench": "vitest bench",
    "bench:run": "vitest bench --run",
    "bench:report": "vitest bench --run --reporter=json > tests/benchmark/results.json"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.936.0",
    "@collm/contracts": "*",
    "@collm/database": "*",
    "fastify": "^4.26.1"
  },
  "devDependencies": {
    "@fastify/cors": "^9.0.0",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
